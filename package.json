{
  "name": "agentforge-studio",
  "version": "1.1.0",
  "description": "AgentForge Studio - Visual AI Workflow & Agent Builder",
  "author": "Ayush <ayush@agentforge.studio>",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "next build && node -e \"const fs=require('fs'); fs.cpSync('.next/static', '.next/standalone/.next/static', {recursive: true}); fs.cpSync('public', '.next/standalone/public', {recursive: true, errorOnExist: false});\" && electron-builder",
    "desktop:pack": "next build && node -e \"const fs=require('fs'); fs.cpSync('.next/static', '.next/standalone/.next/static', {recursive: true}); fs.cpSync('public', '.next/standalone/public', {recursive: true, errorOnExist: false});\" && electron-builder --dir"
  },
  "build": {
    "appId": "com.agentforge.studio",
    "productName": "AgentForge Studio",
    "asarUnpack": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Ayush <ayush@agentforge.studio>",
      "category": "Development"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/mistral": "^4.0.13",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/react": "^4.0.34",
    "@base-ui/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexlayout-react": "^0.10.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "ollama-ai-provider": "^1.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
